# Copie para .env e troque todos os valores. O .env nunca entra no Git.
# Tudo o que define como o serviço sobe fica aqui.
# Para gerar segredos: openssl rand -base64 36 | tr -d '/+='

# ---------- Endereço e rede ----------
# Endereço público do painel e da API, igual ao configurado no proxy reverso (sempre https).
APP_URL=https://telemetria.exemplo.com

# IP e porta publicados na máquina para o proxy reverso apontar (HTTP).
# 0.0.0.0 = todas as interfaces. Neste caso, libere a porta no firewall só para o proxy:
# o Docker publica portas passando por cima de regras comuns do ufw.
HTTP_BIND=0.0.0.0
HTTP_PORT=28470

# De quem aceitar X-Forwarded-For (o IP real do cliente). Vazio = redes privadas.
# Com proxy em IP público, informe esse IP. Liste só proxies confiáveis.
TRUST_PROXY=

# Escuta dentro dos containers. Normalmente não precisa mudar.
WEB_HOST=0.0.0.0
WEB_PORT=28471
API_HOST=0.0.0.0
API_PORT=28472

# ---------- Banco ----------
# Valem só na criação do volume. Trocar aqui depois não muda nada no Postgres.
# Nas senhas, use só letras e números, porque entram na URL de conexão.
DB_NAME=obd
DB_OWNER=obd_owner
POSTGRES_PASSWORD=troque-por-um-segredo
APP_DB_USER=obd_app
APP_DB_PASSWORD=troque-por-outro-segredo

# ---------- Segredos entre serviços (mínimo de 32 caracteres cada) ----------
INTERNAL_API_KEY=troque-por-um-segredo-longo
FORM_SECRET=troque-por-outro-segredo-longo
# Cifra as chaves de dois fatores. Trocar depois invalida o 2FA de todas as contas.
TOTP_ENCRYPTION_KEY=troque-por-mais-um-segredo-longo

# ---------- Superadmin inicial ----------
# Criado só se ainda não houver administrador. A troca é exigida no primeiro login.
# Depois da primeira subida, ADMIN_PASSWORD pode ser apagada daqui.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-frase-longa

# ---------- E-mail (SMTP) ----------
# Vazio ou com valores de exemplo, o serviço mailer não envia e a troca de e-mail fica indisponível.
# No Gmail, use uma senha de app, não a senha da conta.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Telemetria OBD
SMTP_TIMEOUT=10s

# ---------- Mapa ----------
# Pasta com o mapa baixado por scripts/baixar-mapa.sh.
MAP_DATA_DIR=./data/maps

# ---------- Percurso nas ruas (opcional) ----------
# Encaixa o traço do GPS nas ruas, só no desenho do mapa. Prepare os dados com
# scripts/preparar-rotas.sh (download de ~1,8 GB e 30–60 min de processamento) e depois descomente.
# COMPOSE_PROFILES=rotas
# OSRM_URL=http://osrm:5000
OSRM_DATA_DIR=./data/osrm

# ---------- Comportamento ----------
# Valor inicial do cadastro: closed ou open. Depois, muda-se pela tela de administração.
SIGNUP_DEFAULT=closed
RETENTION_DAYS=90
PURGE_INTERVAL_MINUTES=60
MAX_DEVICES_PER_USER=10
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
# Multiplica os limites de requisições por IP. Aumente só se tiver muitos usuários atrás do mesmo IP.
RATE_LIMIT_FACTOR=1
LOG_LEVEL=info
