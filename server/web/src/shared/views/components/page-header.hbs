<div class="page-header">
  <div class="page-header-text">
    <h1 class="page-title">{{#if icon}}<span class="page-title-icon" aria-hidden="true"><i class="fa-solid {{icon}}"></i></span>{{/if}}<span class="text-break">{{title}}</span></h1>
    {{#if subtitle}}<p class="page-subtitle">{{subtitle}}</p>{{/if}}
  </div>
  <div class="page-header-actions">{{> @partial-block}}</div>
</div>
