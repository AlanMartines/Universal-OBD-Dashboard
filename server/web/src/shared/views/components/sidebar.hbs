<nav class="app-sidebar" id="app-sidebar" data-bs-theme="dark" aria-label="Menu principal">
  <div class="sidebar-brand">
    <a href="/painel" class="sidebar-link-plain sidebar-brand-link">
      <img class="brand-logo" src="/assets/logos/eletroinfo.svg" alt=""><span>Telemetria OBD</span>
    </a>
    <button class="btn sidebar-close" type="button" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="true" aria-label="Fechar menu" title="Fechar menu">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
    <button class="btn sidebar-expand" type="button" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="false" aria-label="Abrir menu" title="Abrir menu">
      <img class="brand-logo" src="/assets/logos/eletroinfo.svg" alt="">
    </button>
  </div>

  <div class="sidebar-user" title="{{#if user.displayName}}{{user.displayName}}{{else}}{{user.username}}{{/if}}">
    <div class="sidebar-avatar">
      {{#if user.avatarVersion}}<img src="/conta/foto?v={{user.avatarVersion}}" alt="">{{else}}<span aria-hidden="true">{{initials user.displayName user.username}}</span>{{/if}}
    </div>
    <div class="sidebar-label">
      <div class="sidebar-user-name text-truncate">{{#if user.displayName}}{{user.displayName}}{{else}}{{user.username}}{{/if}}</div>
      <div class="small text-body-secondary">{{roleLabel user.role}}</div>
    </div>
  </div>

  <div class="sidebar-scroll">
    <p class="sidebar-group sidebar-label">Monitoramento</p>
    <ul class="sidebar-nav">
      <li><a href="/painel" title="Dispositivos" class="{{#if (eq activePage "painel")}}active{{/if}}" {{#if (eq activePage "painel")}}aria-current="page"{{/if}}><i class="fa-solid fa-mobile-screen fa-fw" aria-hidden="true"></i><span class="sidebar-label">Dispositivos</span></a></li>
      <li><a href="/painel-veiculo" title="Painel do veículo" class="{{#if (eq activePage "vehicle")}}active{{/if}}" {{#if (eq activePage "vehicle")}}aria-current="page"{{/if}}><i class="fa-solid fa-gauge-high fa-fw" aria-hidden="true"></i><span class="sidebar-label">Painel do veículo</span></a></li>
    </ul>

    {{#if (canManage user)}}
    <p class="sidebar-group sidebar-label">Administração</p>
    <ul class="sidebar-nav">
      <li><a href="/admin" title="{{#if (eq user.role "superadmin")}}Configurações{{else}}Usuários{{/if}}" class="{{#if (eq activePage "admin")}}active{{/if}}" {{#if (eq activePage "admin")}}aria-current="page"{{/if}}><i class="fa-solid fa-gear fa-fw" aria-hidden="true"></i><span class="sidebar-label">{{#if (eq user.role "superadmin")}}Configurações{{else}}Usuários{{/if}}</span></a></li>
    </ul>
    {{/if}}

    <p class="sidebar-group sidebar-label">Conta</p>
    <ul class="sidebar-nav">
      <li><a href="/conta" title="Meus Dados" class="{{#if (eq activePage "conta")}}active{{/if}}" {{#if (eq activePage "conta")}}aria-current="page"{{/if}}><i class="fa-solid fa-circle-user fa-fw" aria-hidden="true"></i><span class="sidebar-label">Meus Dados</span></a></li>
    </ul>
  </div>

  <div class="sidebar-footer">
    <button type="button" data-theme-toggle aria-label="Tema"><i class="fa-solid fa-fw fa-circle-half-stroke" data-theme-icon aria-hidden="true"></i><span class="sidebar-label" data-theme-label>Tema automático</span></button>
    <form method="post" action="/logout" class="m-0">
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <button type="submit" title="Sair"><i class="fa-solid fa-right-from-bracket fa-fw" aria-hidden="true"></i><span class="sidebar-label">Sair</span></button>
    </form>
  </div>
</nav>
<div class="sidebar-backdrop" data-sidebar-close></div>
