<div class="password-meter mt-2" data-password-meter="{{for}}" hidden>
  <div class="progress" role="progressbar" aria-label="Força da senha" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <div class="progress-bar" data-meter-bar></div>
  </div>
  <div class="small fw-semibold mt-1" data-meter-label aria-live="polite"></div>
  <ul class="password-rules list-unstyled small mb-0 mt-1">
    <li data-rule="length"><i class="fa-solid fa-circle fa-2xs me-2" aria-hidden="true"></i>Pelo menos 15 caracteres (obrigatório)</li>
    <li data-rule="varied"><i class="fa-solid fa-circle fa-2xs me-2" aria-hidden="true"></i>Sem repetir sempre os mesmos caracteres (obrigatório)</li>
    <li data-rule="long"><i class="fa-solid fa-circle fa-2xs me-2" aria-hidden="true"></i>20 caracteres ou mais (mais forte)</li>
    <li data-rule="mixed"><i class="fa-solid fa-circle fa-2xs me-2" aria-hidden="true"></i>Maiúsculas e minúsculas (mais forte)</li>
    <li data-rule="digit"><i class="fa-solid fa-circle fa-2xs me-2" aria-hidden="true"></i>Número (mais forte)</li>
    <li data-rule="symbol"><i class="fa-solid fa-circle fa-2xs me-2" aria-hidden="true"></i>Símbolo ou espaço (mais forte)</li>
  </ul>
</div>
