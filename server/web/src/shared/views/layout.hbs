<!doctype html>
<html lang="pt-BR" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>{{title}} · Telemetria OBD</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicons/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicons/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicons/favicon-96x96.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicons/apple-icon-180x180.png">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
  <link rel="stylesheet" href="/static/css/tokens.css">
  <link rel="stylesheet" href="/static/css/layout.css">
  <link rel="stylesheet" href="/static/css/components.css">
  {{#each pageCss}}<link rel="stylesheet" href="{{this}}">
  {{/each}}
  {{#if user}}<script src="/static/js/shell.js"></script>{{/if}}
</head>
<body>
  <div class="toast-container position-fixed top-0 end-0 p-3 app-toasts" id="app-toasts" aria-live="polite"></div>
  {{#if flash}}<div id="app-flash" hidden data-message="{{flash}}"></div>{{/if}}
  {{#if user}}
  {{> sidebar}}
  <div class="app-main">
    <button class="btn sidebar-fab" type="button" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="false" aria-label="Abrir menu">
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>
    {{#if user.impersonatedBy}}
    <div class="impersonation-bar d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2" role="status">
      <span class="small"><i class="fa-solid fa-user-secret me-2" aria-hidden="true"></i><strong>Modo suporte:</strong> vendo como {{user.username}}. Dados pessoais e de segurança ficam bloqueados.</span>
      <form method="post" action="/conta/personificacao/sair" class="m-0">
        <input type="hidden" name="_csrf" value="{{csrf}}">
        <button class="btn btn-warning btn-sm" type="submit">Voltar à minha conta</button>
      </form>
    </div>
    {{/if}}
    <main class="app-content">
      {{{body}}}
    </main>
  </div>
  {{> confirmModal}}
  {{else}}
  <header class="auth-header">
    <a class="sidebar-link-plain" href="/"><img class="brand-logo" src="/assets/logos/eletroinfo.svg" alt=""><span>Telemetria OBD</span></a>
  </header>
  <main class="container-xl py-4">
    {{{body}}}
  </main>
  {{/if}}
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/vendor/jquery/jquery.min.js"></script>
  <script src="/vendor/jquery-validation/jquery.validate.min.js"></script>
  <script src="/static/js/forms.js"></script>
  <script src="/static/js/toast.js"></script>
  {{#if user}}<script src="/static/js/confirm.js"></script>{{/if}}
  {{#each pageScripts}}<script src="{{this}}"></script>
  {{/each}}
  {{#each pageModules}}<script type="module" src="{{this}}"></script>
  {{/each}}
</body>
</html>
