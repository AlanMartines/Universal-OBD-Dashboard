<!doctype html>
<html lang="pt-BR" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>{{title}} · Telemetria OBD</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicons/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicons/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicons/favicon-96x96.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicons/apple-icon-180x180.png">
  <meta name="color-scheme" content="light dark">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0b0f14">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Telemetria">
  <script src="{{asset "/static/js/theme.js"}}"></script>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
  <link rel="stylesheet" href="{{asset "/static/css/tokens.css"}}">
  <link rel="stylesheet" href="{{asset "/static/css/layout.css"}}">
  <link rel="stylesheet" href="{{asset "/static/css/components.css"}}">
  {{#each pageCss}}<link rel="stylesheet" href="{{asset this}}">
  {{/each}}
  {{#if user}}<script src="{{asset "/static/js/shell.js"}}"></script>{{/if}}
</head>
<body>
  <div class="app-toasts" id="app-toasts" aria-live="polite"></div>
  {{#if flash}}<div id="app-flash" hidden data-message="{{flash}}"></div>{{/if}}
  {{#if user}}
  {{> sidebar}}
  <div class="app-main">
    <header class="app-topbar">
      <button class="btn topbar-btn" type="button" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="false" aria-label="Abrir menu">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
      <span class="topbar-title text-truncate">{{title}}</span>
      <a class="topbar-live" data-live-link hidden href="/painel"><span class="live-dot" aria-hidden="true"></span><span data-live-text>Ao vivo</span></a>
      <button class="btn topbar-btn" type="button" data-theme-toggle aria-label="Tema">
        <i class="fa-solid fa-fw fa-circle-half-stroke" data-theme-icon aria-hidden="true"></i>
      </button>
    </header>
    {{#if user.impersonatedBy}}
    <div class="impersonation-bar d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2" role="status">
      <span class="small"><i class="fa-solid fa-user-secret me-2" aria-hidden="true"></i><strong>Modo suporte:</strong> vendo como {{user.username}}. Dados pessoais e de segurança ficam bloqueados.</span>
      <form method="post" action="/meus-dados/personificacao/sair" class="m-0">
        <input type="hidden" name="_csrf" value="{{csrf}}">
        <button class="btn btn-warning btn-sm" type="submit">Voltar à minha conta</button>
      </form>
    </div>
    {{/if}}
    <main class="app-content">
      {{{body}}}
    </main>
  </div>
  {{> confirmModal}}
  {{else if publicPage}}
  <header class="auth-header gap-2">
    <a class="sidebar-link-plain" href="/projeto"><img class="brand-logo" src="/assets/logos/eletroinfo.svg" alt=""><span class="d-none d-sm-inline">Telemetria OBD</span></a>
    <nav class="public-nav ms-auto d-flex align-items-center gap-1 gap-sm-2" aria-label="Projeto">
      <a class="btn btn-sm {{#if (eq activeTab "projeto")}}btn-secondary{{else}}btn-outline-secondary{{/if}}" href="/projeto" {{#if (eq activeTab "projeto")}}aria-current="page"{{/if}}><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span class="d-none d-md-inline ms-1">Projeto</span></a>
      <a class="btn btn-sm {{#if (eq activeTab "sobre")}}btn-secondary{{else}}btn-outline-secondary{{/if}}" href="/sobre" {{#if (eq activeTab "sobre")}}aria-current="page"{{/if}}><i class="fa-solid fa-heart" aria-hidden="true"></i><span class="d-none d-md-inline ms-1">Sobre</span></a>
      <a class="btn btn-sm {{#if (eq activeTab "placa")}}btn-secondary{{else}}btn-outline-secondary{{/if}}" href="/projeto/placa" {{#if (eq activeTab "placa")}}aria-current="page"{{/if}}><i class="fa-solid fa-cube" aria-hidden="true"></i><span class="d-none d-md-inline ms-1">Placa 3D</span></a>
      <a class="btn btn-sm btn-outline-secondary" href="{{repoUrl}}" target="_blank" rel="noopener" title="GitHub"><i class="fa-brands fa-github" aria-hidden="true"></i><span class="d-none d-md-inline ms-1">GitHub</span></a>
      <a class="btn btn-sm btn-primary" href="/login"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i><span class="d-none d-sm-inline ms-1">Entrar</span></a>
      <button class="btn topbar-btn" type="button" data-theme-toggle aria-label="Tema">
        <i class="fa-solid fa-fw fa-circle-half-stroke" data-theme-icon aria-hidden="true"></i>
      </button>
    </nav>
  </header>
  <main class="public-main">
    {{{body}}}
  </main>
  {{else}}
  <header class="auth-header">
    <a class="sidebar-link-plain" href="/"><img class="brand-logo" src="/assets/logos/eletroinfo.svg" alt=""><span>Telemetria OBD</span></a>
    <button class="btn topbar-btn ms-auto" type="button" data-theme-toggle aria-label="Tema">
      <i class="fa-solid fa-fw fa-circle-half-stroke" data-theme-icon aria-hidden="true"></i>
    </button>
  </header>
  <main class="auth-main">
    <aside class="auth-hero" aria-hidden="true">
      <img class="auth-hero-logo" src="/assets/logos/eletroinfo.svg" alt="">
      <h2>Telemetria do seu veículo, em tempo real</h2>
      <ul>
        <li><i class="fa-solid fa-gauge-high"></i>Painel ao vivo e percurso no mapa</li>
        <li><i class="fa-solid fa-gas-pump"></i>Consumo real, abastecimentos e relatórios</li>
        <li><i class="fa-solid fa-triangle-exclamation"></i>Falhas do motor e alertas</li>
        <li><i class="fa-solid fa-shield-halved"></i>Dados no seu próprio servidor</li>
      </ul>
    </aside>
    <div class="auth-card">
      <div class="auth-brand">
        <img class="auth-logo" src="/assets/logos/eletroinfo.svg" alt="">
        <p class="small text-body-secondary mb-0">Telemetria do seu veículo, em tempo real</p>
      </div>
      {{{body}}}
    </div>
  </main>
  {{/if}}
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/vendor/jquery/jquery.min.js"></script>
  <script src="/vendor/jquery-validation/jquery.validate.min.js"></script>
  <script src="{{asset "/static/js/forms.js"}}"></script>
  <script src="{{asset "/static/js/toast.js"}}"></script>
  <script src="{{asset "/static/js/pwa.js"}}"></script>
  {{#if user}}<script src="{{asset "/static/js/tooltips.js"}}"></script>
  <script src="{{asset "/static/js/live-indicator.js"}}"></script>{{/if}}
  {{#if user}}<script src="{{asset "/static/js/confirm.js"}}"></script>{{/if}}
  {{#each pageScripts}}<script src="{{asset this}}"></script>
  {{/each}}
  {{#each pageModules}}<script type="module" src="{{asset this}}"></script>
  {{/each}}
</body>
</html>
