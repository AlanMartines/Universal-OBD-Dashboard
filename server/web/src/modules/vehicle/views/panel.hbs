<div class="vehicle-bar d-flex flex-wrap align-items-center gap-2 mb-2">
  <h1 class="h5 mb-0 me-auto">Painel do veículo</h1>
  {{#if devices.length}}
  <form method="get" action="/painel-veiculo" class="d-flex align-items-center gap-2" data-vehicle-select>
    <label class="visually-hidden" for="vehicle-device">Veículo</label>
    <select class="form-select form-select-sm w-auto" id="vehicle-device" name="dispositivo">
      {{#each devices}}<option value="{{id}}"{{#if selected}} selected{{/if}}>{{name}}</option>{{/each}}
    </select>
    <noscript><button class="btn btn-primary btn-sm" type="submit">Abrir</button></noscript>
  </form>
  <span id="vehicle-status" class="badge text-bg-secondary" role="status">Conectando…</span>
  <button class="btn btn-outline-secondary btn-sm" type="button" id="vehicle-fullscreen" title="Tela cheia" aria-label="Tela cheia"><i class="fa-solid fa-expand" aria-hidden="true"></i></button>
  {{/if}}
</div>
{{#if deviceId}}
<div id="vehicle-root" data-device-id="{{deviceId}}" data-sample="{{latestJson}}" data-limits="{{limitsJson}}"{{#if replayTrip}} data-replay-trip="{{replayTrip}}" class="is-replay"{{/if}}>
  {{#if replayTrip}}
  <div class="replay-bar" id="replay-bar" aria-label="Simulação da viagem">
    <button class="btn btn-primary btn-sm" type="button" id="replay-play" title="Reproduzir" aria-label="Reproduzir" disabled><i class="fa-solid fa-play" aria-hidden="true"></i></button>
    <div class="btn-group btn-group-sm" role="group" aria-label="Velocidade da simulação">
      <button class="btn btn-outline-secondary active" type="button" data-replay-speed="1" aria-pressed="true">1×</button>
      <button class="btn btn-outline-secondary" type="button" data-replay-speed="5" aria-pressed="false">5×</button>
      <button class="btn btn-outline-secondary" type="button" data-replay-speed="16" aria-pressed="false">16×</button>
    </div>
    <input class="form-range replay-seek" type="range" id="replay-seek" min="0" max="1000" step="1" value="0" aria-label="Posição na viagem" disabled>
    <span class="replay-time small" id="replay-time">--:--</span>
    <a class="btn btn-outline-secondary btn-sm" href="/painel-veiculo?dispositivo={{deviceId}}" title="Sair da simulação"><i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>Sair</a>
  </div>
  {{/if}}
  <div id="dash-host" class="cluster-host" aria-label="Painel de instrumentos"></div>
  <details class="sensor-cal" id="sensor-cal">
    <summary>Calibração dos sensores</summary>
    <dl class="sensor-cal-list">
      <dt>Desvio do giroscópio</dt><dd id="sc-gyro">--</dd>
      <dt>Celular no suporte</dt><dd id="sc-phone">--</dd>
      <dt>Bússola do ESP32</dt><dd id="sc-compass">--</dd>
      <dt>Ajuste fino</dt><dd id="sc-trim">--</dd>
    </dl>
    <p class="small text-body-secondary mb-0">Medido e aprendido pelo app; o ajuste fino é feito no app, em Ajustes → Calibração dos sensores.</p>
  </details>
</div>
{{else}}
<div class="card">
  {{> emptyState icon="fa-gauge-high" title="Nenhum veículo conectado ainda" text="Adicione um dispositivo para ver o painel em tempo real."}}
</div>
{{/if}}
