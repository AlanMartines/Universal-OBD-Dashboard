<div class="page-header mb-4">
  <h1 class="h3 mb-1"><i class="fa-solid {{#if isSuper}}fa-gear{{else}}fa-users{{/if}} text-primary me-2" aria-hidden="true"></i>{{#if isSuper}}Configurações{{else}}Usuários{{/if}}</h1>
  <p class="text-body-secondary mb-0">{{#if isSuper}}Usuários, cadastro público e auditoria do painel{{else}}Pessoas que acessam os dados da sua conta{{/if}}</p>
</div>

<ul class="admin-stats">
  <li><span class="admin-stat-icon" aria-hidden="true"><i class="fa-solid fa-users"></i></span><span><b>{{stats.users}}</b><small>usuários</small></span></li>
  <li><span class="admin-stat-icon" aria-hidden="true"><i class="fa-solid fa-user-check"></i></span><span><b>{{stats.active}}</b><small>ativos</small></span></li>
  <li><span class="admin-stat-icon" aria-hidden="true"><i class="fa-solid fa-shield-halved"></i></span><span><b>{{stats.mfa}}</b><small>com 2FA</small></span></li>
  <li><span class="admin-stat-icon" aria-hidden="true"><i class="fa-solid fa-mobile-screen"></i></span><span><b>{{stats.devices}}</b><small>dispositivos pareados</small></span></li>
  {{#if isSuper}}<li class="{{#if stats.refused}}is-alert{{/if}}"><span class="admin-stat-icon" aria-hidden="true"><i class="fa-solid fa-ban"></i></span><span><b>{{stats.refused}}</b><small>acessos recusados (24 h)</small></span></li>{{/if}}
</ul>
{{> formError}}
{{#if created}}
<div class="alert alert-success" role="alert">
  Usuário <strong>{{created.username}}</strong> criado. Senha temporária, mostrada só agora:
  <code class="user-select-all text-break">{{created.password}}</code>
</div>
{{/if}}

<div class="row g-4 mb-4">
  {{#if isSuper}}
  <div class="col-md-5">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center gap-2">
        <h2 class="h6 fw-semibold mb-0"><i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>Cadastro público</h2>
        {{#if signupOpen}}<span class="badge text-bg-warning">Aberto</span>{{else}}<span class="badge text-bg-secondary">Fechado</span>{{/if}}
      </div>
      <div class="card-body">
        <p class="text-body-secondary">{{#if signupOpen}}Qualquer pessoa com o endereço do painel pode criar uma conta de Admin.{{else}}Só você cria contas. Abra apenas quando quiser receber cadastros pelo site.{{/if}}</p>
        <form method="post" action="/admin/cadastro" {{#unless signupOpen}}data-confirm="Abrir o cadastro público? Qualquer pessoa poderá criar uma conta." data-confirm-label="Abrir cadastro" data-confirm-tone="warning"{{/unless}}>
          <input type="hidden" name="_csrf" value="{{csrf}}">
          <input type="hidden" name="open" value="{{#if signupOpen}}false{{else}}true{{/if}}">
          <button class="btn btn-outline-primary" type="submit"><i class="fa-solid {{#if signupOpen}}fa-lock{{else}}fa-lock-open{{/if}} me-1" aria-hidden="true"></i>{{#if signupOpen}}Fechar cadastro{{else}}Abrir cadastro{{/if}}</button>
        </form>
      </div>
    </div>
  </div>
  {{/if}}
  <div class="{{#if isSuper}}col-md-7{{else}}col-12{{/if}}">
    <div class="card h-100">
      <div class="card-header"><h2 class="h6 fw-semibold mb-0"><i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>Novo usuário</h2></div>
      <div class="card-body">
        {{#unless isSuper}}<p class="small text-body-secondary">Usuários de atendimento só visualizam os dados da sua conta.</p>{{/unless}}
        <form method="post" action="/admin/usuarios" class="row g-2" data-validate>
          <input type="hidden" name="_csrf" value="{{csrf}}">
          <div class="{{#if isSuper}}col-sm-6{{else}}col-sm-9{{/if}}">
            <label class="form-label small fw-semibold required-mark" for="new-username">Usuário</label>
            <input class="form-control" id="new-username" name="username" autocomplete="off" maxlength="32" data-rule-username="true" required>
          </div>
          {{#if isSuper}}
          <div class="col-sm-6">
            <label class="form-label small fw-semibold" for="new-role">Perfil</label>
            <select class="form-select" id="new-role" name="role">
              <option value="user">Usuário (atendimento)</option>
              <option value="admin">Admin (dono de conta)</option>
              <option value="superadmin">Super Admin</option>
            </select>
          </div>
          <div class="col-12" id="new-account-box">
            <label class="form-label small fw-semibold required-mark" for="new-account">Conta vinculada</label>
            <select class="form-select" id="new-account" name="accountId" required>
              <option value="">Selecione a conta</option>
              {{#each accounts}}<option value="{{id}}">{{username}}</option>{{/each}}
            </select>
            {{#unless accounts.length}}<div class="form-text">Crie primeiro um usuário Admin: a conta é dele.</div>{{/unless}}
          </div>
          {{else}}
          <input type="hidden" name="role" value="user">
          {{/if}}
          <div class="{{#if isSuper}}col-12 text-end{{else}}col-sm-3 d-flex align-items-end{{/if}}">
            <button class="btn btn-primary {{#unless isSuper}}w-100{{/unless}}" type="submit"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Criar</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<h2 class="h5 mb-3"><i class="fa-solid fa-users me-2 text-body-secondary" aria-hidden="true"></i>Usuários</h2>
{{#> dataTable}}
    <thead class="table-dark"><tr><th>Usuário</th><th>E-mail</th><th>Perfil</th><th>Conta</th><th>Situação</th><th>Dispositivos</th><th>Criado em</th><th scope="col" class="text-center">Ação</th></tr></thead>
    <tbody>
      {{#each users}}
      <tr>
        <td data-label="Usuário" class="text-break">{{username}}</td>
        <td data-label="E-mail" class="text-break">{{email}}</td>
        <td data-label="Perfil"><span class="badge role-badge role-{{role}}">{{roleLabel role}}</span></td>
        <td data-label="Conta">{{account}}</td>
        <td data-label="Situação">
          {{#if disabled}}<span class="badge text-bg-secondary">Desativado</span>{{else}}<span class="badge text-bg-success">Ativo</span>{{/if}}
          {{#if must_change_password}}<span class="badge text-bg-warning">Trocar senha</span>{{/if}}
          {{#if mfa}}<span class="badge text-bg-light border" title="Verificação em duas etapas ativa"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> 2FA</span>{{/if}}
        </td>
        <td data-label="Dispositivos">{{devices}}</td>
        <td data-label="Criado em">{{date created_at}}</td>
        <td class="table-actions text-center">
          {{#unless (eq id ../user.id)}}
          {{#if ../isSuper}}{{#unless (eq role "superadmin")}}{{#unless disabled}}
          <form method="post" action="/admin/usuarios/{{id}}/personificar" class="d-inline" data-confirm="Entrar como {{username}}? A sessão de suporte dura 1 hora e fica registrada na auditoria." data-confirm-label="Entrar" data-confirm-tone="primary">
            <input type="hidden" name="_csrf" value="{{../csrf}}">
            <button class="btn btn-outline-primary btn-sm" type="submit"><i class="fa-solid fa-user-secret me-1" aria-hidden="true"></i>Entrar como</button>
          </form>
          {{/unless}}{{/unless}}{{/if}}
          <form method="post" action="/admin/usuarios/{{id}}/status" class="d-inline" {{#unless disabled}}data-confirm="Desativar {{username}}? As sessões abertas serão encerradas." data-confirm-label="Desativar" data-confirm-tone="warning"{{/unless}}>
            <input type="hidden" name="_csrf" value="{{../csrf}}">
            <input type="hidden" name="disabled" value="{{#if disabled}}false{{else}}true{{/if}}">
            <button class="btn btn-outline-warning btn-sm" type="submit"><i class="fa-solid {{#if disabled}}fa-user-check{{else}}fa-user-slash{{/if}} me-1" aria-hidden="true"></i>{{#if disabled}}Ativar{{else}}Desativar{{/if}}</button>
          </form>
          <form method="post" action="/admin/usuarios/{{id}}/excluir" class="d-inline" data-confirm="Excluir {{username}}? Dispositivos, telemetria e usuários vinculados também serão apagados." data-confirm-label="Excluir" data-confirm-tone="danger">
            <input type="hidden" name="_csrf" value="{{../csrf}}">
            <button class="btn btn-outline-danger btn-sm" type="submit"><i class="fa-solid fa-trash me-1" aria-hidden="true"></i>Excluir</button>
          </form>
          {{/unless}}
        </td>
      </tr>
      {{/each}}
    </tbody>
{{/dataTable}}
{{> pagination pager=usersPager label="Páginas de usuários"}}

{{#if isSuper}}
<h2 class="h5 mb-3 mt-4"><i class="fa-solid fa-clipboard-list me-2 text-body-secondary" aria-hidden="true"></i>Auditoria recente</h2>
{{#> dataTable}}
    <thead class="table-dark"><tr><th>Quando</th><th>Quem</th><th>Ação</th><th>Alvo</th><th>IP</th></tr></thead>
    <tbody>
      {{#each audit}}
      <tr><td data-label="Quando">{{date at}}</td><td data-label="Quem" class="text-break">{{actor}}</td><td data-label="Ação"><span class="audit-action text-{{tone}}-emphasis" title="{{action}}"><i class="fa-solid {{icon}} fa-fw" aria-hidden="true"></i>{{label}}</span></td><td data-label="Alvo" class="text-break">{{target}}</td><td data-label="IP" class="text-break">{{ip}}</td></tr>
      {{/each}}
    </tbody>
{{/dataTable}}
{{> pagination pager=auditPager label="Páginas da auditoria"}}
{{/if}}
