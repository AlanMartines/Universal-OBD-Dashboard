<div class="row justify-content-center">
  <div class="col-sm-10 col-md-6 col-lg-4">
    <h1 class="page-title mb-3"><span class="page-title-icon" aria-hidden="true"><i class="fa-solid fa-key"></i></span>Trocar senha</h1>
    {{#if required}}<div class="alert alert-warning" role="alert">Defina uma nova senha para continuar.</div>{{/if}}
    {{> formError}}
    <form method="post" action="/meus-dados/senha" data-validate>
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <input type="hidden" id="current-username" value="{{user.username}}">
      <div class="mb-3">
        <label class="form-label required-mark" for="currentPassword">Senha atual</label>
        <input class="form-control" id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required>
      </div>
      <div class="mb-3">
        <label class="form-label required-mark" for="newPassword">Nova senha</label>
        <input class="form-control" id="newPassword" name="newPassword" type="password" autocomplete="new-password" data-rule-strongpassword="true" data-rule-notusername="#current-username" required>
        <div class="form-text">Uma frase longa é uma boa opção.</div>
        {{> passwordStrength for="newPassword"}}
      </div>
      <div class="mb-3">
        <label class="form-label required-mark" for="confirm">Repita a nova senha</label>
        <input class="form-control" id="confirm" name="confirm" type="password" autocomplete="new-password" data-rule-equalto="#newPassword" required>
      </div>
      <button class="btn btn-primary w-100" type="submit">Salvar</button>
    </form>
  </div>
</div>
