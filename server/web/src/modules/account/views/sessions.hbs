<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1"><i class="fa-solid fa-shield-halved text-primary me-2" aria-hidden="true"></i>Sessões ativas</h1>
    <p class="text-body-secondary mb-0">Dispositivos com sua conta conectada no momento</p>
  </div>
  {{#if hasOthers}}
  <form method="post" action="/meus-dados/sessoes/encerrar-outras" data-confirm="Encerrar todas as outras sessões?" data-confirm-label="Encerrar" data-confirm-tone="warning">
    <input type="hidden" name="_csrf" value="{{csrf}}">
    <button class="btn btn-outline-danger btn-sm" type="submit"><i class="fa-solid fa-right-from-bracket me-1" aria-hidden="true"></i>Encerrar as outras</button>
  </form>
  {{/if}}
</div>

<ul class="session-list">
  {{#each sessions}}
  <li class="session-card{{#if current}} is-current{{/if}}">
    <span class="session-icon" aria-hidden="true"><i class="fa-solid {{#if device.mobile}}fa-mobile-screen{{else}}fa-desktop{{/if}}"></i></span>
    <div class="session-body">
      <div class="session-title">
        <span class="fw-semibold" title="{{user_agent}}">{{device.label}}</span>
        {{#if current}}<span class="badge session-badge-current"><i class="fa-solid fa-circle me-1" aria-hidden="true"></i>Sessão atual</span>{{/if}}
        {{#if support}}<span class="badge text-bg-warning">Suporte</span>{{/if}}
      </div>
      <ul class="session-meta">
        <li title="IP"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span class="visually-hidden">IP: </span>{{ip}}</li>
        <li><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>Login {{date created_at}}</li>
        <li><i class="fa-regular fa-clock" aria-hidden="true"></i>Ativo {{activeAgo}}</li>
        <li><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>Expira {{date expires_at}}</li>
      </ul>
    </div>
    {{#unless current}}
    <form method="post" action="/meus-dados/sessoes/{{id}}/encerrar" class="session-action" data-confirm="Encerrar esta sessão?" data-confirm-label="Encerrar" data-confirm-tone="warning">
      <input type="hidden" name="_csrf" value="{{../csrf}}">
      <button class="btn btn-outline-danger btn-sm" type="submit" aria-label="Encerrar a sessão {{device.label}}"><i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>Encerrar</button>
    </form>
    {{/unless}}
  </li>
  {{/each}}
</ul>
