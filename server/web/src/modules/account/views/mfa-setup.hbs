<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <h1 class="h3 mb-2"><i class="fa-solid fa-shield-halved text-primary me-2" aria-hidden="true"></i>Ativar verificação em duas etapas</h1>
    <ol class="mfa-progress mb-3" aria-label="Etapas">
      <li class="done">Senha</li>
      <li class="current" aria-current="step">QR Code e código</li>
      <li>Códigos de recuperação</li>
    </ol>
    {{> formError}}
    <div class="card mb-3">
      <div class="card-body text-center">
        <p>Escaneie no aplicativo autenticador, como Google Authenticator, Microsoft Authenticator ou Authy.</p>
        <img class="mfa-qr mb-3" src="{{qr}}" alt="QR Code para o aplicativo autenticador" width="220" height="220">
        <p class="small text-body-secondary mb-1">Ou digite esta chave:</p>
        <code class="user-select-all text-break">{{secret}}</code>
      </div>
    </div>
    <form method="post" action="/meus-dados/2fa/ativar" data-validate>
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <div class="mb-3">
        <label class="form-label fw-semibold required-mark" for="code">Código de 6 dígitos</label>
        <input class="form-control" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" minlength="6" maxlength="6" required autofocus>
      </div>
      <button class="btn btn-primary" type="submit">Ativar</button>
      <a class="btn btn-outline-secondary" href="/meus-dados">Cancelar</a>
    </form>
  </div>
</div>
