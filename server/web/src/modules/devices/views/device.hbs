<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h1 class="h3 mb-1">{{device.name}}</h1>
    <p class="small text-body-secondary mb-0">Conta: {{device.owner}} · App {{device.appVersion}}</p>
  </div>
  <span id="live-status" class="badge text-bg-secondary" role="status">Conectando…</span>
</div>

<div id="live-root" data-device-id="{{device.id}}">
  <div id="latest-data" hidden data-sample="{{latestJson}}"></div>
  <p id="no-data" class="text-body-secondary d-none">Ainda não chegaram dados deste dispositivo.</p>
  <p class="small text-body-secondary">Última leitura: <span id="last-update">—</span></p>
  <div id="metrics" class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4"></div>

  <div id="dtc-box" class="alert alert-warning d-none" role="alert">
    <strong>Códigos de falha:</strong> <span id="dtc-list"></span>
  </div>
  <p id="gps-box" class="small text-body-secondary d-none">Posição: <span id="gps-text"></span></p>

  <div class="card">
    <div class="card-body">
      <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <h2 class="h5 mb-0 me-auto">Histórico</h2>
        <label class="visually-hidden" for="chart-metric">Sinal</label>
        <select id="chart-metric" class="form-select form-select-sm w-auto"></select>
        <label class="visually-hidden" for="chart-hours">Período</label>
        <select id="chart-hours" class="form-select form-select-sm w-auto">
          <option value="1">1 hora</option>
          <option value="6">6 horas</option>
          <option value="24">24 horas</option>
          <option value="168">7 dias</option>
        </select>
      </div>
      <div class="chart-box"><canvas id="history-chart" aria-label="Gráfico do sinal escolhido" role="img"></canvas></div>
    </div>
  </div>
</div>
