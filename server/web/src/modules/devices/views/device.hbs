<div class="device-head d-flex flex-wrap align-items-center gap-2 mb-3">
  <div class="me-auto min-w-0">
    <h1 class="h4 mb-0 text-break">{{device.name}}</h1>
    <p class="small text-body-secondary mb-0">Conta: {{device.owner}}{{#if device.appVersion}} · App {{device.appVersion}}{{/if}}</p>
  </div>
  <span id="live-status" class="badge text-bg-secondary" role="status">Sem dados</span>
  <span id="last-update" class="small text-body-secondary"></span>
  <a class="btn btn-outline-primary btn-sm" href="/painel-veiculo?dispositivo={{device.id}}"><i class="fa-solid fa-gauge-high me-1" aria-hidden="true"></i>Painel do veículo</a>
</div>

<div id="live-root" data-device-id="{{device.id}}">
  <div id="latest-data" hidden data-sample="{{latestJson}}" data-limits="{{limitsJson}}"></div>
  <p id="no-data" class="text-body-secondary d-none">Ainda não chegaram dados deste dispositivo.</p>

  <div id="dtc-box" class="alert alert-warning d-none" role="alert">
    <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i><strong>Códigos de falha:</strong> <span id="dtc-list"></span>
  </div>


  <ul class="nav nav-tabs device-tabs mb-3" role="tablist" data-tabs>
    <li class="nav-item" role="presentation"><button class="nav-link active" id="tab-overview" data-bs-toggle="tab" data-bs-target="#pane-overview" data-hash="visao-geral" type="button" role="tab" aria-controls="pane-overview" aria-selected="true"><i class="fa-solid fa-gauge me-1" aria-hidden="true"></i>Visão geral</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-history" data-bs-toggle="tab" data-bs-target="#pane-history" data-hash="historico" type="button" role="tab" aria-controls="pane-history" aria-selected="false"><i class="fa-solid fa-chart-line me-1" aria-hidden="true"></i>Histórico</button></li>
    {{#if locationAllowed}}<li class="nav-item" role="presentation"><button class="nav-link" id="tab-route" data-bs-toggle="tab" data-bs-target="#pane-route" data-hash="percurso" type="button" role="tab" aria-controls="pane-route" aria-selected="false"><i class="fa-solid fa-route me-1" aria-hidden="true"></i>Percurso</button></li>{{/if}}
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-trips" data-bs-toggle="tab" data-bs-target="#pane-trips" data-hash="viagens" type="button" role="tab" aria-controls="pane-trips" aria-selected="false"><i class="fa-solid fa-road me-1" aria-hidden="true"></i>Viagens</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-fuel" data-bs-toggle="tab" data-bs-target="#pane-fuel" data-hash="abastecimentos" type="button" role="tab" aria-controls="pane-fuel" aria-selected="false"><i class="fa-solid fa-gas-pump me-1" aria-hidden="true"></i>Abastecimentos</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-faults" data-bs-toggle="tab" data-bs-target="#pane-faults" data-hash="falhas" type="button" role="tab" aria-controls="pane-faults" aria-selected="false"><i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>Falhas{{#if faultsActive}} <span class="badge text-bg-danger">{{faultsActive}}</span>{{/if}}</button></li>
  </ul>

  <div class="tab-content">
  <div class="tab-pane fade show active" id="pane-overview" role="tabpanel" aria-labelledby="tab-overview" tabindex="0">
  <div class="row row-cols-2 row-cols-lg-4 g-3 mb-3" id="highlights"></div>

  <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-3" id="groups"></div>

  <div id="gps-box" class="d-none">
    <button type="button" class="btn btn-outline-secondary btn-sm" id="gps-toggle" aria-expanded="false"><i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i>Ver localização</button>
    <span id="gps-text" class="small text-body-secondary ms-2" hidden></span>
  </div>
  {{#unless locationAllowed}}
  <p class="small text-body-secondary"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>A localização de outras contas só fica disponível no modo suporte, registrado na auditoria.</p>
  {{/unless}}
  </div>

  <div class="tab-pane fade" id="pane-history" role="tabpanel" aria-labelledby="tab-history" tabindex="0">
  <section class="stat-panel mb-3" aria-labelledby="history-title">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <h2 class="h6 mb-0 me-auto" id="history-title">Histórico</h2>
      <label class="visually-hidden" for="chart-metric">Sinal</label>
      <select id="chart-metric" class="form-select form-select-sm w-auto"></select>
      <label class="visually-hidden" for="chart-compare">Comparar com</label>
      <select id="chart-compare" class="form-select form-select-sm w-auto"><option value="">Comparar com…</option></select>
      <div class="btn-group btn-group-sm" role="group" aria-label="Período" id="chart-range">
        <button type="button" class="btn btn-outline-secondary" data-minutes="5">5 min</button>
        <button type="button" class="btn btn-outline-secondary active" data-minutes="15">15 min</button>
        <button type="button" class="btn btn-outline-secondary" data-minutes="60">1 h</button>
        <button type="button" class="btn btn-outline-secondary" data-minutes="360">6 h</button>
        <button type="button" class="btn btn-outline-secondary" data-minutes="1440">24 h</button>
        <button type="button" class="btn btn-outline-secondary" data-minutes="10080">7 d</button>
      </div>
    </div>
    <div class="chart-box"><canvas id="history-chart" aria-label="Gráfico do sinal escolhido" role="img"></canvas></div>
  </section>
  </div>

  {{#if locationAllowed}}
  <div class="tab-pane fade" id="pane-route" role="tabpanel" aria-labelledby="tab-route" tabindex="0">
  <section class="stat-panel mb-3" id="route-card" data-device-id="{{device.id}}" data-has-map="{{hasMap}}" aria-labelledby="route-title">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <h2 class="h6 mb-0 me-auto" id="route-title">Percurso <span class="small fw-normal text-body-secondary" id="route-summary"></span></h2>
      <label class="visually-hidden" for="route-trip">Viagem</label>
      <select id="route-trip" class="form-select form-select-sm w-auto"><option value="">Todas as viagens do período</option></select>
      <div class="btn-group btn-group-sm" role="group" aria-label="Período do percurso" id="route-range">
        <button type="button" class="btn btn-outline-secondary" data-minutes="60">1 h</button>
        <button type="button" class="btn btn-outline-secondary active" data-minutes="1440">24 h</button>
        <button type="button" class="btn btn-outline-secondary" data-minutes="10080">7 d</button>
      </div>
    </div>
    <p class="small text-body-secondary" id="route-notice" hidden></p>
    <div class="route-map" id="route-map" hidden></div>
    <p class="route-legend small text-body-secondary mt-2 mb-0">
      <span class="route-dot route-slow"></span>até 30 km/h <span class="route-dot route-mid"></span>até 60 <span class="route-dot route-fast"></span>até 90 <span class="route-dot route-top"></span>acima de 90
    </p>
  </section>
  </div>
  {{/if}}

  <div class="tab-pane fade" id="pane-trips" role="tabpanel" aria-labelledby="tab-trips" tabindex="0">
  <section class="stat-panel mb-3" aria-labelledby="trips-title">
    <h2 class="h6 mb-3" id="trips-title"><i class="fa-solid fa-road me-1" aria-hidden="true"></i>Viagens</h2>
    {{#if trips.length}}
    <p class="small text-body-secondary mb-2">Montadas a partir das leituras enviadas pelo app. Distância e combustível são estimados pela velocidade e pelo consumo instantâneo.</p>
    <div class="table-responsive">
      <table class="table table-sm table-striped table-hover table-stack align-middle mb-0">
        <thead class="table-dark">
          <tr><th scope="col">Início</th><th scope="col" class="text-end">Duração</th><th scope="col" class="text-end">Distância</th><th scope="col" class="text-end">Combustível</th><th scope="col" class="text-end">km/l</th><th scope="col" class="text-end">Vel. máx.</th><th scope="col" class="text-end">Temp. máx.</th>{{#if ../locationAllowed}}<th scope="col" class="text-end">Mapa</th>{{/if}}</tr>
        </thead>
        <tbody>
          {{#each trips}}
          <tr><td data-label="Início">{{date start}}</td><td data-label="Duração" class="text-end">{{minutes}} min</td><td data-label="Distância" class="text-end">{{num km 1}} km</td><td data-label="Combustível" class="text-end">{{num liters 2}} L</td><td data-label="km/l" class="text-end">{{num kmPerL 1}}</td><td data-label="Vel. máx." class="text-end">{{num maxSpeed 0}} km/h</td><td data-label="Temp. máx." class="text-end">{{num maxCoolant 0}} °C</td>{{#if ../locationAllowed}}<td data-label="Mapa" class="table-actions text-end"><button class="btn btn-outline-primary btn-sm" type="button" data-show-trip="{{id}}" title="Ver no mapa" aria-label="Ver a viagem no mapa"><i class="fa-solid fa-route" aria-hidden="true"></i></button></td>{{/if}}</tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <div class="empty-state"><i class="fa-solid fa-road" aria-hidden="true"></i><p class="mb-0">Nenhuma viagem enviada ainda. Elas aparecem quando o app grava uma captura com a telemetria remota ligada.</p></div>
    {{/if}}
  </section>
  </div>

  <div class="tab-pane fade" id="pane-fuel" role="tabpanel" aria-labelledby="tab-fuel" tabindex="0">
  <section class="stat-panel mb-3" aria-labelledby="fuel-title">
    <h2 class="h6 mb-3" id="fuel-title"><i class="fa-solid fa-gas-pump me-1" aria-hidden="true"></i>Abastecimentos</h2>
    {{#if fuel.items.length}}
    <div class="row row-cols-1 row-cols-sm-3 g-2 mb-3">
      <div class="col"><div class="fuel-stat"><span class="small text-body-secondary">Consumo real</span><strong>{{#if fuel.summary.avgKmPerL}}{{num fuel.summary.avgKmPerL 1}} km/l{{else}}—{{/if}}</strong><span class="small text-body-secondary">entre tanques cheios</span></div></div>
      <div class="col"><div class="fuel-stat"><span class="small text-body-secondary">Custo por km</span><strong>{{brl fuel.summary.costPerKm}}</strong><span class="small text-body-secondary">{{brl fuel.summary.totalCost}} no total</span></div></div>
      <div class="col"><div class="fuel-stat"><span class="small text-body-secondary">Gasto no mês</span><strong>{{#if fuel.month}}{{brl fuel.month.total}}{{else}}—{{/if}}</strong><span class="small text-body-secondary">{{fuel.month.label}}</span></div></div>
    </div>
    <p class="small text-body-secondary mb-2">Últimos abastecimentos registrados no app. Os apagados no app ficam aqui por {{fuel.removedDays}} dias, marcados, e não entram nas contas.</p>
    <div class="table-responsive">
      <table class="table table-sm table-striped table-hover table-stack align-middle mb-2">
        <thead class="table-dark">
          <tr><th scope="col">Data</th><th scope="col" class="text-end">Litros</th><th scope="col" class="text-end">Valor</th><th scope="col" class="text-end">R$/L</th><th scope="col">Combustível</th><th scope="col">Tanque</th><th scope="col" class="text-end">Hodômetro</th></tr>
        </thead>
        <tbody>
          {{#each fuel.recent}}
          <tr{{#if removedAt}} class="fuel-removed"{{/if}}><td data-label="Data">{{date ts}}{{#if removedAt}} <span class="badge text-bg-secondary">Removido no app</span>{{/if}}</td><td data-label="Litros" class="text-end">{{num liters 3}}</td><td data-label="Valor" class="text-end">{{brl totalPrice}}</td><td data-label="R$/L" class="text-end">{{num pricePerLiter 3}}</td><td data-label="Combustível">{{fuelName fuelType}}{{#if ethanolPct}} ({{num ethanolPct 0}}% etanol){{/if}}</td><td data-label="Tanque">{{#if fullTank}}Cheio{{else}}Parcial{{/if}}</td><td data-label="Hodômetro" class="text-end">{{#if odometerKm}}{{num odometerKm 0}} km{{else}}—{{/if}}</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{#if fuel.intervals.length}}
    <h3 class="h6 mt-3">Consumo medido</h3>
    <div class="table-responsive">
      <table class="table table-sm table-striped table-hover table-stack align-middle mb-0">
        <thead class="table-dark">
          <tr><th scope="col">Período</th><th scope="col" class="text-end">km/l</th><th scope="col" class="text-end">km</th><th scope="col" class="text-end">Litros</th><th scope="col" class="text-end">R$/km</th><th scope="col">Combustível</th></tr>
        </thead>
        <tbody>
          {{#each fuel.intervals}}
          <tr><td data-label="Período">{{date from}} → {{date to}}</td><td data-label="km/l" class="text-end">{{num kmPerL 1}}</td><td data-label="km" class="text-end">{{num km 0}}</td><td data-label="Litros" class="text-end">{{num liters 2}}</td><td data-label="R$/km" class="text-end">{{brl costPerKm}}</td><td data-label="Combustível">{{fuelName fuelType}}</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <p class="small text-body-secondary mb-0">O consumo real aparece depois de dois tanques cheios com hodômetro.</p>
    {{/if}}
    {{else}}
    <p class="small text-body-secondary mb-0">Nenhum abastecimento enviado ainda. Os registrados no app chegam aqui com a telemetria remota ligada.</p>
    {{/if}}
  </section>
  </div>

  <div class="tab-pane fade" id="pane-faults" role="tabpanel" aria-labelledby="tab-faults" tabindex="0">
  <section class="stat-panel mb-3" aria-labelledby="faults-title">
    <h2 class="h6 mb-3" id="faults-title"><i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>Falhas</h2>
    {{#if faults.length}}
    <p class="small text-body-secondary mb-2">Códigos enviados pelo app. A descrição é a genérica da norma SAE; a análise detalhada e a do fabricante ficam no app.</p>
    <div class="table-responsive">
      <table class="table table-sm table-striped table-hover table-stack align-middle mb-0">
        <thead class="table-dark">
          <tr><th scope="col">Código</th><th scope="col">Descrição</th><th scope="col">Situação</th><th scope="col">Primeira vez</th><th scope="col">Última vez</th></tr>
        </thead>
        <tbody>
          {{#each faults}}
          <tr><td data-label="Código" class="font-monospace fw-semibold">{{code}}</td><td data-label="Descrição" data-dtc-describe="{{code}}">—</td><td data-label="Situação">{{#if active}}<span class="badge text-bg-danger">Ativa</span>{{else}}<span class="badge text-bg-secondary">Não aparece mais</span>{{/if}}</td><td data-label="Primeira vez">{{date firstSeen}}</td><td data-label="Última vez">{{date lastSeen}}</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <div class="empty-state"><i class="fa-solid fa-circle-check text-success" aria-hidden="true"></i><p class="mb-0">Nenhum código de falha enviado por este veículo.</p></div>
    {{/if}}
  </section>
  </div>
  </div>
</div>
