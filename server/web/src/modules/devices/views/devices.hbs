{{#> pageHeader title="Dispositivos"}}
  {{#if (canManage user)}}
  <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#add-device-modal"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Adicionar dispositivo</button>
  {{/if}}
{{/pageHeader}}
{{> formError}}
{{#if vehicles.length}}
<section class="mb-4" aria-labelledby="fleet-title">
  <h2 class="visually-hidden" id="fleet-title">Veículos</h2>
  <div class="row row-cols-1 row-cols-md-2 row-cols-xxl-3 g-3">
    {{#each vehicles}}
    <div class="col">
      <article class="vehicle-card h-100">
        <header class="vehicle-card-head">
          <span class="vehicle-card-icon" aria-hidden="true"><i class="fa-solid fa-car-side"></i></span>
          <div class="min-w-0 me-auto">
            <h3 class="h6 mb-0 text-truncate">{{name}}</h3>
            {{#if (eq ../user.role "superadmin")}}<p class="small text-body-secondary mb-0 text-truncate">{{owner}}</p>{{/if}}
          </div>
          <span class="badge text-bg-{{status.tone}}">{{#if status.live}}<span class="live-dot" aria-hidden="true"></span>{{/if}}{{status.label}}</span>
        </header>
        <dl class="vehicle-card-stats">
          <div><dt>Falhas ativas</dt><dd class="{{#if dtcCount}}text-danger{{/if}}">{{dtcCount}}</dd></div>
          <div><dt>Consumo real</dt><dd>{{#if avgKmPerL}}{{num avgKmPerL 1}} <small>km/l</small>{{else}}—{{/if}}</dd></div>
          <div><dt>Gasto em {{../monthLabel}}</dt><dd>{{brl monthCost}}</dd></div>
          <div><dt>Hodômetro{{#if odometerFromFuelUp}} <span class="fw-normal">(no último abastecimento)</span>{{/if}}</dt><dd>{{#if odometerKm}}{{num odometerKm 0}} <small>km</small>{{else}}—{{/if}}</dd></div>
        </dl>
        <footer class="vehicle-card-actions">
          <a class="btn btn-primary btn-sm" href="/dispositivos/{{id}}"><i class="fa-solid fa-eye me-1" aria-hidden="true"></i>Detalhes</a>
          <a class="btn btn-outline-primary btn-sm" href="/painel-veiculo?dispositivo={{id}}"><i class="fa-solid fa-gauge-high me-1" aria-hidden="true"></i>Painel do veículo</a>
          {{#if dtcCount}}<a class="btn btn-outline-danger btn-sm" href="/dispositivos/{{id}}#falhas"><i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>Falhas</a>{{/if}}
        </footer>
      </article>
    </div>
    {{/each}}
  </div>
</section>
<h2 class="h6 text-body-secondary mb-2">Todos os dispositivos</h2>
{{/if}}
{{#if devices.length}}
{{#> dataTable}}
    <thead class="table-dark">
      <tr><th>Nome</th>{{#if (eq user.role "superadmin")}}<th>Conta</th>{{/if}}<th>Situação</th><th>Último envio</th><th>ID da instalação</th><th scope="col" class="text-center">Ação</th></tr>
    </thead>
    <tbody>
      {{#each devices}}
      <tr>
        <td data-label="Nome" class="text-break">{{name}}</td>
        {{#if (eq ../user.role "superadmin")}}<td data-label="Conta">{{owner}}</td>{{/if}}
        <td data-label="Situação">
          {{#if revokedAt}}<span class="badge text-bg-secondary">Revogado</span>
          {{else if pairedAt}}<span class="badge text-bg-success">Pareado</span>
          {{else}}<span class="badge text-bg-warning">Aguardando pareamento</span>{{/if}}
        </td>
        <td data-label="Último envio">{{date lastSeenAt}}</td>
        <td data-label="ID da instalação" class="small text-body-secondary font-monospace text-break">{{installationId}}</td>
        <td class="table-actions text-center">
          {{#if pairedAt}}<a class="btn btn-primary btn-sm" href="/dispositivos/{{id}}" title="Visualizar" aria-label="Visualizar {{name}}"><i class="fa-solid fa-eye" aria-hidden="true"></i></a>
          <a class="btn btn-outline-primary btn-sm" href="/painel-veiculo?dispositivo={{id}}" title="Painel do veículo" aria-label="Painel do veículo de {{name}}"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i></a>{{/if}}
          {{#if (canManage ../user)}}
          {{#unless revokedAt}}
          <form method="post" action="/dispositivos/{{id}}/revogar" class="d-inline" data-confirm="Revogar {{name}}? O aparelho deixa de enviar dados." data-confirm-label="Revogar">
            <input type="hidden" name="_csrf" value="{{../csrf}}">
            <button class="btn btn-outline-warning btn-sm" type="submit">Revogar</button>
          </form>
          {{/unless}}
          <form method="post" action="/dispositivos/{{id}}/excluir" class="d-inline" data-confirm="Excluir {{name}} e toda a sua telemetria? Não tem como desfazer." data-confirm-label="Excluir">
            <input type="hidden" name="_csrf" value="{{../csrf}}">
            <button class="btn btn-outline-danger btn-sm" type="submit">Excluir com dados</button>
          </form>
        {{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
{{/dataTable}}
{{> pagination pager=pager label="Páginas de dispositivos"}}
{{else}}
<div class="card card-body text-center py-5">
  <p class="mb-1">Nenhum dispositivo ainda.</p>
  {{#if (canManage user)}}<p class="text-body-secondary mb-0">Clique em Adicionar dispositivo para gerar o código de pareamento.</p>{{/if}}
</div>
{{/if}}

{{#if (canManage user)}}
<div class="modal fade" id="add-device-modal" tabindex="-1" aria-labelledby="add-device-title" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h5" id="add-device-title">Adicionar dispositivo</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <div id="add-device-step-form">
          <div class="alert alert-danger" id="add-device-error" role="alert" hidden></div>
          <form method="post" action="/dispositivos" id="add-device-form" data-validate>
            <input type="hidden" name="_csrf" value="{{csrf}}">
            <label class="form-label fw-semibold required-mark" for="name">Nome do dispositivo</label>
            <input class="form-control" id="name" name="name" placeholder="Ex.: celular do carro" maxlength="60" required>
          </form>
        </div>
        <div id="add-device-step-wait" class="text-center" hidden>
          <p class="text-body-secondary mb-2">Código de pareamento</p>
          <p class="pairing-code font-monospace mb-2" id="add-device-code"></p>
          <p class="small text-body-secondary">Vale por <span id="add-device-minutes"></span> minutos, uma única vez.</p>
          <ol class="text-start small">
            <li>No app, abra <strong>Ajustes → Telemetria remota</strong>.</li>
            <li>Informe o endereço <strong class="text-break">{{serverUrl}}</strong> e o código acima.</li>
            <li>Toque em <strong>Parear</strong>.</li>
          </ol>
          <div class="d-flex justify-content-center align-items-center gap-2" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Aguardando o app se conectar…</span>
          </div>
        </div>
        <div id="add-device-step-done" class="text-center" role="status" hidden>
          <i class="fa-solid fa-circle-check fa-3x text-success mb-3" aria-hidden="true"></i>
          <p class="mb-0 fw-semibold">Dispositivo conectado.</p>
        </div>
        <div id="add-device-step-expired" class="text-center" role="status" hidden>
          <i class="fa-solid fa-clock fa-3x text-warning mb-3" aria-hidden="true"></i>
          <p class="mb-0">O código venceu. Feche e adicione de novo.</p>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" id="add-device-cancel" data-bs-dismiss="modal">Fechar</button>
        <button type="submit" form="add-device-form" class="btn btn-primary" id="add-device-submit">Adicionar</button>
        <button type="button" class="btn btn-success" id="add-device-ok" data-bs-dismiss="modal" hidden>OK</button>
      </div>
    </div>
  </div>
</div>
{{/if}}
