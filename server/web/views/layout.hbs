<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>{{title}} · Telemetria OBD</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
  <link rel="stylesheet" href="/static/css/app.css">
  {{#if user}}<script src="/static/js/shell.js"></script>{{/if}}
</head>
<body>
  {{#if user}}
  {{> sidebar}}
  <div class="app-main">
    <header class="app-topbar">
      <button class="btn btn-link sidebar-toggle" type="button" id="sidebar-toggle" aria-controls="app-sidebar" aria-expanded="true" aria-label="Mostrar ou esconder o menu">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
      <span class="app-topbar-title text-truncate">{{title}}</span>
    </header>
    <main class="app-content">
      {{{body}}}
    </main>
  </div>
  {{else}}
  <header class="auth-header">
    <a class="sidebar-link-plain" href="/"><i class="fa-solid fa-gauge-high fa-fw" aria-hidden="true"></i><span>Telemetria OBD</span></a>
  </header>
  <main class="container-xl py-4">
    {{{body}}}
  </main>
  {{/if}}
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  {{#if scripts}}
  <script src="/vendor/chartjs/chart.umd.min.js"></script>
  <script src="/static/js/live.js"></script>
  {{/if}}
</body>
</html>
