{
  "schema_version": 1,
  "profile_id": "generic",
  "title": "Mapeamento da rede do carro",
  "groups": [
    {
      "id": "ignition",
      "title": "Ignição ligada, motor desligado",
      "note": "Carro estacionado, freio de mão puxado e 1ª marcha engatada (ou P no automático). Todas as portas fechadas, exceto a do passo.",
      "steps": [
        { "id": "ign_quiet", "title": "Referência: sem tocar em nada", "priority": true, "engine": "off",
          "phases": [{ "say": "Ignição ligada. Não toque em nada.", "s": 60 }] },
        { "id": "door_driver", "title": "Porta do motorista", "priority": true, "engine": "off",
          "pattern": { "on": "Abra a porta do motorista", "off": "Feche a porta", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "door_passenger", "title": "Porta do passageiro", "engine": "off",
          "before": "Dê a volta no carro ou peça ajuda.",
          "pattern": { "on": "Abra a porta do passageiro", "off": "Feche a porta", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "door_rear_left", "title": "Porta traseira esquerda (se tiver)", "engine": "off",
          "pattern": { "on": "Abra a porta traseira esquerda", "off": "Feche a porta", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "door_rear_right", "title": "Porta traseira direita (se tiver)", "engine": "off",
          "pattern": { "on": "Abra a porta traseira direita", "off": "Feche a porta", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "trunk", "title": "Porta-malas", "engine": "off",
          "pattern": { "on": "Abra o porta-malas", "off": "Feche o porta-malas", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "hood", "title": "Capô (se tiver sensor)", "engine": "off",
          "before": "Pule se o carro não avisa capô aberto.",
          "pattern": { "on": "Abra o capô", "off": "Feche o capô", "on_s": 15, "off_s": 15, "repeat": 2 } },
        { "id": "seatbelt_driver", "title": "Cinto do motorista", "priority": true, "engine": "off",
          "pattern": { "on": "Afivele o cinto", "off": "Solte o cinto", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "seatbelt_passenger", "title": "Cinto do passageiro (se tiver aviso)", "engine": "off",
          "pattern": { "on": "Afivele o cinto do passageiro", "off": "Solte o cinto", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "brake_pedal", "title": "Pedal de freio", "priority": true, "engine": "off",
          "pattern": { "on": "Pise no freio", "off": "Solte o freio", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "clutch_pedal", "title": "Pedal de embreagem (manual)", "engine": "off",
          "pattern": { "on": "Pise na embreagem", "off": "Solte a embreagem", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "handbrake", "title": "Freio de mão (só em piso plano)", "priority": true, "engine": "off",
          "before": "Só em piso plano, com a 1ª engatada (ou P) e os pés fora dos pedais. Sem piso plano, pule este passo.",
          "after": "Termine com o freio de mão puxado.",
          "pattern": { "on": "Solte o freio de mão", "off": "Puxe o freio de mão", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "reverse", "title": "Marcha à ré", "priority": true, "engine": "off",
          "before": "Freio de mão puxado. No manual, pise na embreagem para trocar a marcha.",
          "after": "Termine com a 1ª engatada (ou P).",
          "pattern": { "on": "Engate a ré", "off": "Volte para a primeira", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "parking_lights", "title": "Lanterna", "engine": "off",
          "pattern": { "on": "Ligue a lanterna", "off": "Desligue a lanterna", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "low_beam", "title": "Farol baixo", "engine": "off",
          "pattern": { "on": "Ligue o farol baixo", "off": "Desligue o farol", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "high_beam", "title": "Farol alto", "priority": true, "engine": "off",
          "before": "Ligue o farol baixo antes e deixe ligado durante o passo.",
          "after": "Desligue os faróis.",
          "pattern": { "on": "Farol alto", "off": "Volte ao farol baixo", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "high_beam_flash", "title": "Lampejo do farol alto", "engine": "off",
          "before": "Faróis desligados.",
          "pattern": { "on": "Três toques no lampejo", "off": "Pare", "on_s": 5, "off_s": 10, "repeat": 3 } },
        { "id": "fog_front", "title": "Farol de neblina dianteiro (se tiver)", "engine": "off",
          "pattern": { "on": "Ligue o farol de neblina", "off": "Desligue o farol de neblina", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "fog_rear", "title": "Luz de neblina traseira (se tiver)", "engine": "off",
          "pattern": { "on": "Ligue a neblina traseira", "off": "Desligue a neblina traseira", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "turn_left", "title": "Seta esquerda", "engine": "off",
          "pattern": { "on": "Seta para a esquerda", "off": "Desligue a seta", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "turn_right", "title": "Seta direita", "engine": "off",
          "pattern": { "on": "Seta para a direita", "off": "Desligue a seta", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "hazard", "title": "Pisca-alerta", "engine": "off",
          "pattern": { "on": "Ligue o pisca-alerta", "off": "Desligue o pisca-alerta", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "interior_light", "title": "Luz interna", "engine": "off",
          "before": "Pelo interruptor, com as portas fechadas.",
          "pattern": { "on": "Acenda a luz interna", "off": "Apague a luz interna", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "wiper_front", "title": "Limpador dianteiro", "engine": "off",
          "before": "Molhe o vidro antes, para não riscar.",
          "pattern": { "on": "Ligue o limpador na primeira velocidade", "off": "Desligue o limpador", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "wiper_rear", "title": "Limpador traseiro (se tiver)", "engine": "off",
          "before": "Molhe o vidro antes, para não riscar.",
          "pattern": { "on": "Ligue o limpador traseiro", "off": "Desligue o limpador traseiro", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "washer", "title": "Esguicho do para-brisa", "engine": "off",
          "pattern": { "on": "Acione o esguicho", "off": "Solte o esguicho", "on_s": 3, "off_s": 10, "repeat": 3 } },
        { "id": "door_lock", "title": "Trava elétrica (se tiver)", "engine": "off",
          "before": "Pelo botão interno, com as portas fechadas.",
          "pattern": { "on": "Trave as portas", "off": "Destrave as portas", "on_s": 10, "off_s": 10, "repeat": 3 } },
        { "id": "window_driver", "title": "Vidro elétrico do motorista (se tiver)", "engine": "off",
          "before": "Comece com o vidro fechado.",
          "pattern": { "on": "Abra o vidro", "off": "Feche o vidro", "on_s": 6, "off_s": 8, "repeat": 2 } },
        { "id": "horn", "title": "Buzina (opcional)", "engine": "off",
          "before": "Só onde não incomodar ninguém.",
          "pattern": { "on": "Buzine rápido", "off": "Solte", "on_s": 1, "off_s": 8, "repeat": 3 } }
      ]
    },
    {
      "id": "idle",
      "title": "Motor em marcha lenta",
      "note": "Ao ar livre, nunca em garagem fechada. Freio de mão puxado e ponto morto (ou P).",
      "steps": [
        { "id": "idle_quiet", "title": "Referência: marcha lenta sem tocar em nada", "priority": true, "engine": "on",
          "before": "Tudo desligado: ventilação, ar-condicionado, faróis e rádio.",
          "phases": [{ "say": "Marcha lenta. Não toque em nada.", "s": 120 }] },
        { "id": "blower", "title": "Ventilação interna", "engine": "on",
          "pattern": { "on": "Ligue a ventilação na velocidade dois", "off": "Desligue a ventilação", "on_s": 30, "off_s": 30, "repeat": 3 } },
        { "id": "ac", "title": "Ar-condicionado (se tiver)", "priority": true, "engine": "on",
          "before": "Deixe a ventilação na velocidade 2 durante todo o passo. Liga e desliga só o botão A/C.",
          "after": "Desligue a ventilação.",
          "pattern": { "on": "Ligue o ar-condicionado", "off": "Desligue o ar-condicionado", "on_s": 30, "off_s": 30, "repeat": 3 } },
        { "id": "rear_defrost", "title": "Desembaçador traseiro (se tiver)", "engine": "on",
          "pattern": { "on": "Ligue o desembaçador traseiro", "off": "Desligue o desembaçador", "on_s": 30, "off_s": 30, "repeat": 3 } },
        { "id": "steering", "title": "Direção: volante até o fim (se for hidráulica)", "engine": "on",
          "before": "Gire devagar e não segure no batente por mais tempo que o passo pede.",
          "pattern": { "on": "Gire o volante até o fim", "off": "Volte o volante ao centro", "on_s": 5, "off_s": 10, "repeat": 3 } }
      ]
    },
    {
      "id": "hot",
      "title": "Motor quente",
      "note": "Faça depois de rodar ou de aquecer em marcha lenta. Ponto morto (ou P), freio de mão puxado.",
      "steps": [
        { "id": "rpm_fixed", "title": "Rotações fixas", "priority": true, "engine": "on",
          "before": "Guie-se pela rotação na tela Painel do app; ela chega com cerca de meio segundo de atraso. Faixa de 200 RPM para mais ou para menos serve. Não passe de 3.000 RPM.",
          "phases": [
            { "say": "Marcha lenta", "s": 30 },
            { "say": "Acelere e segure dois mil", "s": 20 },
            { "say": "Solte. Marcha lenta", "s": 20 },
            { "say": "Acelere e segure três mil", "s": 20 },
            { "say": "Solte. Marcha lenta", "s": 20 },
            { "say": "Acelere e segure dois mil", "s": 20 },
            { "say": "Solte. Marcha lenta", "s": 20 },
            { "say": "Acelere e segure três mil", "s": 20 },
            { "say": "Solte. Marcha lenta", "s": 20 }
          ] },
        { "id": "radiator_fan", "title": "Eletroventilador do radiador", "priority": true, "engine": "on",
          "before": "Marcha lenta, sem acelerar, tudo desligado. Toque no botão quando o ventilador ligar e quando desligar. Acima de 105 °C ou com alerta, desligue o motor.",
          "events": ["Ventilador ligou", "Ventilador desligou"], "max_s": 1500 }
      ]
    },
    {
      "id": "shutdown",
      "title": "Desligamento",
      "note": "No fim do dia ou antes de sair com uma captura nova.",
      "steps": [
        { "id": "engine_off", "title": "Motor desligado, ignição ligada", "priority": true, "engine": "off",
          "before": "Desligue o motor e deixe a chave na posição de ignição ligada.",
          "after": "Desligue a ignição. Se a captura não encerrar sozinha, toque em Encerrar.",
          "phases": [{ "say": "Ignição ligada. Não toque em nada.", "s": 30 }] }
      ]
    },
    {
      "id": "moving",
      "title": "Em movimento",
      "place": "moving",
      "note": "O motorista só dirige, com a captura rodando, e não mexe no celular. Os passos daqui são feitos pelo passageiro.",
      "steps": [
        { "id": "economy_gauge", "title": "Indicador de economia (passageiro)", "passenger": true, "engine": "on",
          "before": "Só o passageiro mexe no celular. Em trechos constantes, subidas e retomadas, toque na posição do ponteiro sempre que ela mudar.",
          "max_s": 3600,
          "zones": [
            { "label": "Vermelho", "color": "red", "options": ["Alto", "Médio", "Baixo"] },
            { "label": "Meio", "color": "neutral", "options": ["Meio"] },
            { "label": "Verde", "color": "green", "options": ["Baixo", "Médio", "Alto"] }
          ] }
      ]
    }
  ]
}
