<?xml version="1.0" encoding="utf-8"?>
<!--
  Nada sai do aparelho pelo backup do Android, nem para a nuvem nem na transferência para um celular
  novo: o banco tem o percurso pelo GPS, e as preferências guardam o token do painel e a chave da IA.
  Para trocar de celular, use o backup do próprio app (Ajustes → Backup completo), que deixa as chaves de fora.
  No Android 11 ou anterior, quem desliga tudo é o allowBackup="false" do manifesto.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
