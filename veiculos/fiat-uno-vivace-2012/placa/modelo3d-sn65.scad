// Placa ilhada da escuta CAN (Uno Vivace): modelo 3D aproximado.
// Gerado por gerar_3d.py: não edite à mão. Abra no OpenSCAD e aperte F5.
// Coordenadas em mm: x para a direita, y para cima (linha 1 no topo), z para cima.

mostrar_esp32 = true;   // ESP32
mostrar_modulos = true;   // SN65HVD230 e RT8272
mostrar_fusivel = true;   // Fusível
mostrar_bmp180 = true;   // BMP180
mostrar_lsm6ds3 = true;   // LSM6DS3
mostrar_fios = true;   // Fios por cima
mostrar_trilhas = true;   // Trilhas por baixo
$fn = 16;

// as peças vêm com y para baixo (como no desenho 2D); aqui y é invertido
module bx(c, s, cor) color(cor) translate([c[0] - s[0] / 2, -c[1] - s[1] / 2, c[2] - s[2] / 2]) cube(s);
module cl(a, b, r, cor) {
    A = [a[0], -a[1], a[2]]; B = [b[0], -b[1], b[2]]; v = B - A; L = norm(v);
    if (L > 0) color(cor) translate(A) rotate([0, acos(v[2] / L), atan2(v[1], v[0])]) cylinder(r = r, h = L);
}
module bl(c, r, cor) color(cor) translate([c[0], -c[1], c[2]]) sphere(r);

module ilhas() for (c = [1:18], r = [1:24]) {
    x = 3.41 + (c - 1) * 2.54; y = -(5.79 + (r - 1) * 2.54);
    color("#d4a24c") { translate([x, y, 1.6]) cylinder(r = 0.88, h = 0.05); translate([x, y, -0.05]) cylinder(r = 0.88, h = 0.05); }
    color("#4e3b22") { translate([x, y, 1.65]) cylinder(r = 0.42, h = 0.02); translate([x, y, -0.07]) cylinder(r = 0.42, h = 0.02); }
}

